<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:textColorPrimary">@color/app_ink</item>
        <item name="android:textColorSecondary">@color/app_muted</item>
    </style>

    <style name="HelpHeading">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_ink</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="HelpBody">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/app_ink</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
